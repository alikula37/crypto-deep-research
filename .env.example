# Crypto Deep Research - ortam değişkenleri
# Tümü opsiyoneldir. Anahtarsiz da sistem çalışır; anahtar verilen kaynaklar devreye girer.

# CoinGecko Demo API (ücretsiz, opsiyonel ama önerilir): https://www.coingecko.com/en/developers/dashboard
CDR_COINGECKO_API_KEY=

# Coinalyze (ücretsiz API anahtari): https://coinalyze.net/
CDR_COINALYZE_API_KEY=

# CryptoPanic (ücretsiz API anahtari): https://cryptopanic.com/developers/api/
CDR_CRYPTOPANIC_API_KEY=

# Etherscan (ücretsiz): https://etherscan.io/apis
CDR_ETHERSCAN_API_KEY=

# FRED (ücretsiz): https://fred.stlouisfed.org/docs/api/api_key.html
CDR_FRED_API_KEY=

# OpenRouter (opsiyonel; bos ise yalnızca prompt üretilir): https://openrouter.ai/keys
CDR_OPENROUTER_API_KEY=
CDR_OPENROUTER_MODEL=openrouter/auto

# Veri dizini (rapor ve promptlar)
CDR_DATA_DIR=data

# SQLite ve vektor deposu icin ic durum dizini (varsayilan: CDR_DATA_DIR).
# Docker'da /state gibi konteyner ici kalici birime isaret etmek WAL guvenligi saglar.
# CDR_STATE_DIR=/state

# Yerel embedding (fastembed). Ilk kullanımda model indirilir (~2GB).
# Daha küçük model için: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CDR_EMBEDDING_MODEL=intfloat/multilingual-e5-large
CDR_EMBEDDINGS_ENABLED=true
CDR_RAG_CHUNK_TOKENS=240
CDR_RAG_CHUNK_OVERLAP_TOKENS=40
# sentence: tam cümleleri 240 token bütçesine sığdırır; 40 token en fazla overlap hedefidir.
# token: karşılaştırma için eski sabit token penceresi. Değişiklikten sonra rag-reindex gerekir.
CDR_RAG_CHUNK_STRATEGY=sentence

# Opsiyonel yerel FastEmbed cross-encoder reranker (model boşsa RRF kullanılır).
# İngilizce, Apache-2.0: Xenova/ms-marco-MiniLM-L-6-v2
# Çok dilli, CC-BY-NC-4.0 (ticari kullanım yok): jinaai/jina-reranker-v2-base-multilingual
CDR_RAG_RERANKER_MODEL=

# Takip listesi (watchlist) otomatik kosulari
CDR_WATCHLIST_ENABLED=true
CDR_WATCHLIST_INTERVAL_MINUTES=60
CDR_WATCHLIST_AUTO_RUN_HOURS=24

# Telegram botu (opsiyonel): BotFather'dan alinan token
CDR_TELEGRAM_TOKEN=
# Edge alarmi ve bildirimler icin hedef sohbet (botu baslatip /start yazinca id'yi ogrenin)
CDR_TELEGRAM_CHAT_ID=
# Botu sunucu baslarken otomatik baslat (web arayuzunden de baslatilabilir)
CDR_TELEGRAM_AUTOSTART=false

# Ogrenme dongusu (ozellik kaydi + ileri getiri etiketleme)
CDR_LEARNING_ENABLED=true
CDR_OUTCOME_INTERVAL_MINUTES=60
CDR_OUTCOME_MAX_ATTEMPTS=14

# Veri hizlandirma + bakim
CDR_WATCHLIST_SEED=true
CDR_DRIFT_WINDOW_DAYS=30
CDR_DRIFT_BASELINE_DAYS=90
CDR_CACHE_PRUNE_DAYS=7
CDR_ARCHIVE_RUNS_DAYS=540
