# Crypto Deep Research - ortam degiskenleri
# Tumu opsiyoneldir. Anahtarsiz da sistem calisir; anahtar verilen kaynaklar devreye girer.

# CoinGecko Demo API (ucretsiz, opsiyonel ama onerilir): https://www.coingecko.com/en/developers/dashboard
CDR_COINGECKO_API_KEY=

# Coinalyze (ucretsiz API anahtari): https://coinalyze.net/
CDR_COINALYZE_API_KEY=

# CryptoPanic (ucretsiz API anahtari): https://cryptopanic.com/developers/api/
CDR_CRYPTOPANIC_API_KEY=

# Etherscan (ucretsiz): https://etherscan.io/apis
CDR_ETHERSCAN_API_KEY=

# FRED (ucretsiz): https://fred.stlouisfed.org/docs/api/api_key.html
CDR_FRED_API_KEY=

# OpenRouter (opsiyonel; bos ise yalnizca prompt uretilir): https://openrouter.ai/keys
CDR_OPENROUTER_API_KEY=
CDR_OPENROUTER_MODEL=openrouter/auto

# Veri dizini
CDR_DATA_DIR=data

# Yerel embedding (fastembed). Ilk kullanimda model indirilir (~2GB).
# Daha kucuk model icin: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CDR_EMBEDDING_MODEL=intfloat/multilingual-e5-large
CDR_EMBEDDINGS_ENABLED=true
